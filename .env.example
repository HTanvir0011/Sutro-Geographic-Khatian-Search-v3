# Optional: absolute path to khatian image directory. By default uses ./khatian
# Your folder: C:\gol tanvir\khatian
SUTRO_KHATIAN_IMAGE_DIR=C:\gol tanvir\khatian
# Local deed image copies, numbered by filenames such as dolil_1.jpg.
SUTRO_DOLIL_IMAGE_DIR=C:\gol tanvir\Dolil
HOST=127.0.0.1
PORT=5000
# Set when scanning PDFs via phone/LAN, example http://192.168.0.100:5000
PUBLIC_BASE_URL=
# Optional initial admin password (12–128 characters). Leave empty to set it at /admin locally.
SUTRO_ADMIN_PASSWORD=
# Optional OCR executable override; Windows default is auto-detected.
SUTRO_TESSERACT_CMD=
# Set to 1 when serving over HTTPS.
SUTRO_COOKIE_SECURE=0
# Optional vision transcription for scanned deed PDFs.
# Keep the key private; never commit the real .env file.
SUTRO_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
SUTRO_AI_MODEL=gpt-4o
SUTRO_AI_MAX_PAGES=20
# SUTRO_AI_API_KEY=replace-me
